    time: '09:05',
    caseId: 'AEG-00890',
  },
];

// ─── Officer / unit positions ──────────────────────────────────────────────────
const OFFICERS = [
  {
    id: 'o1',
    latitude: 6.4535,
    longitude: 3.3965,
    name: 'Unit Alpha',
    initials: 'KT',
    status: 'on_scene',
    statusLabel: 'On Scene',
    color: '#3B82F6',
  },
  {

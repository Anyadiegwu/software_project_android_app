// ─── Types ────────────────────────────────────────────────────────────────────
type Severity = 'HIGH' | 'MEDIUM' | 'LOW';
type Status   = 'UNDER REVIEW' | 'IN PROGRESS' | 'RESOLVED' | 'DRAFTS';
type FilterTab = 'ALL' | 'UNDER REVIEW' | 'IN PROGRESS' | 'RESOLVED' | 'DRAFTS';

interface Report {
  id: string;
  caseId: string;
  title: string;
  severity: Severity;
  status: Status;

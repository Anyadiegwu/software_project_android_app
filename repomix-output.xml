                                Report incidents anonymously, track your submissions, and
                                access your community safety map. No identity required.
                            </Text>
                            <Text style={styles.btnTextGreen}>Continue as Crime Reporter →</Text>
                        </View>
                    </TouchableOpacity>

                    <TouchableOpacity

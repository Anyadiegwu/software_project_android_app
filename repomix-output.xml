                    <Text style={styles.sosIcon}>🚨</Text>
                    <View style={styles.sosTextContainer}>
                        <Text style={styles.sosTitle}>Emergency SOS</Text>
                        <Text style={styles.sosDesc}>Broadcast your live location to security.</Text>
                    </View>
                </TouchableOpacity>

                {/* Primary Action */}
                <TouchableOpacity

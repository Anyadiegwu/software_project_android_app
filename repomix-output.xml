<file path="styles/global.css">
/* Import Premium Fonts */
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap');

:root {
    /* Color Palette */
    --caribbean-green: #00D4AA;
    --ebony: #0D1526;
    --buttercup: #F59E0B;
    --dodger-blue: #3B82F6;
    --white: #FFFFFF;
    --glass-stroke: rgba(255, 255, 255, 0.1);

    /* Typography */
    --font-main: 'DM Sans', sans-serif;
    --font-heading: 'Playfair Display', serif;
    --font-mono: 'DM Mono', monospace;
}

/* Base Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: var(--ebony);
    color: var(--white);
    font-family: var(--font-main);
    line-height: 1.6;
    overflow-x: hidden;
}

/* Premium Glassmorphism Utility */
.glass-card {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-stroke);
    border-radius: 16px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.glass-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    border-color: var(--caribbean-green);
}

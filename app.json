{
  "expo": {
    "name": "AegisSafeCommunity",
    "slug": "aegis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/image.png",
    "scheme": "aegis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aegis needs your location to show nearby safety incidents on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Aegis needs your location to alert you about safety incidents nearby."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0F1E",
        "foregroundImage": "./assets/images/image.png"
      },
      "jsEngine": "hermes",
      "enableProguardInReleaseBuilds": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.veekthor.aegissafecommunity"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aegis needs your location to show safety incidents near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0F1E",
          "dark": {
            "backgroundColor": "#0A0F1E"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6fdfc700-3266-4804-80b7-c922b70cad7d"
      }
    },
    "owner": "veekthor"
  }
}

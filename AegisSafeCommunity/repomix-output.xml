    accent: '#2DD4BF',
    bg: 'rgba(45,212,191,0.08)',
    border: 'rgba(45,212,191,0.2)',
    onPress: () => Alert.alert('Live Chat', 'Live chat support is coming soon. Try email or phone for now.'),

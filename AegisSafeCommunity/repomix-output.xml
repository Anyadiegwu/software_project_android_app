}

function RowCard({ children }: { children: React.ReactNode }) {
  return <View style={styles.rowCard}>{children}</View>;
}

function SettingRow({
  icon,
  title,
  subtitle,
  subtitleColor,
  right,
}: {
  icon: React.ReactNode;
  title: string;

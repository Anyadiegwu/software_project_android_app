            <Text style={styles.cardMetaText}>{item.tag}</Text>
          </>
        )}
        {item.verified && (
          <>
            <Text style={styles.metaDot}>·</Text>
            <Text style={styles.verifiedText}>Verified resident</Text>
          </>
        )}
      </View>

      {/* Reactions */}
      <View style={styles.reactionsRow}>

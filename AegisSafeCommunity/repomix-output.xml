        </View>
      </View>

      {/* Body */}
      <Text style={styles.cardBody}>{item.body}</Text>

      {/* Meta */}
      <View style={styles.cardMeta}>
        <Text style={styles.cardMetaText}>{item.timeAgo}</Text>

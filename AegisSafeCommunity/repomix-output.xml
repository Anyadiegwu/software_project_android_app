  },
];

// ─── Officer / unit positions ──────────────────────────────────────────────────
const OFFICERS = [
  {
    id: 'o1',
    latitude: 6.4535,
    longitude: 3.3965,
    name: 'Unit Alpha',
    initials: 'KT',
    status: 'on_scene',
    statusLabel: 'On Scene',

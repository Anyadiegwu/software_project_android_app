                                        </View>
                                        <View style={styles.summaryRow}>
                                            <Text style={styles.summaryLabel}>ANONYMOUS</Text>
                                            <Text style={styles.summaryValue}>{isAnonymous ? 'YES' : 'NO'}</Text>

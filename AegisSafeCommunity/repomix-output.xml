    <Path d="M8 12.5l3 3 5-6" stroke="#FFFFFF" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" />
  </Svg>
);

const ArrowRightIcon = () => (
  <Svg width="16" height="16" viewBox="0 0 24 24" fill="none">
